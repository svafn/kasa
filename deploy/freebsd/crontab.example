# Завдання cron для касової книги.
# Установлення від імені користувача, під яким працює застосунок:
#
#   crontab -e          (від користувача sva, НЕ від root)
#
# Перевірити, що встановилося:  crontab -l

SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
TZ=Europe/Kiev
# Порожній MAILTO вимикає листи від cron. Якщо хочете отримувати
# повідомлення про збої — вкажіть свою адресу замість порожнього значення.
MAILTO=""

KASA=/home/sva/www/kasa/deploy/freebsd

# Підняти застосунок після перезавантаження сервера.
# Рядок не потрібен, якщо встановлено службу rc.d (kasa.rc).
@reboot            sleep 30 && $KASA/runa.sh

# Сторож: кожні 5 хвилин перевіряє, чи застосунок живий і чи відповідає
# на HTTP. У звичайному стані мовчить, у журнал пише лише перезапуски.
*/5 * * * *        $KASA/check_runa.sh

# Резервна копія бази щодня о 23:00, після закриття операційного дня.
0 23 * * *         $KASA/backup.sh

# Контроль цілісності закритих аркушів касової книги — щопонеділка о 7:30.
# Виявляє зміни в закритих днях, зроблені в обхід програми.
30 7 * * 1         $KASA/verify.sh
